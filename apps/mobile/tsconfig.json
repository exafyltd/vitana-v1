{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@vitana/core/*": ["../../packages/core/src/*"],
      "@vitana/tokens": ["../../packages/tokens/src/index.ts"],
      "@/*": ["../../src/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "probe-dist", ".expo", "android", "ios"]
}
