{
  "name": "@vitana/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Vitana native app (Expo SDK 57). Wave 0 skeleton (VTID-05157) + Wave 1 core/tokens wiring (VTID-05183) — see README.md.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "gen:i18n": "node ../../scripts/native/gen-i18n-map.mjs",
    "pretypecheck": "npm run gen:i18n",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen:i18n",
    "test": "jest",
    "prebundle": "npm run gen:i18n",
    "bundle": "expo export --platform ios --platform android --output-dir dist",
    "bundle:core-probe": "mkdir -p probe-dist && expo export:embed --entry-file probe/core-probe.ts --platform ios --dev false --minify false --bundle-output probe-dist/ios.js --sourcemap-output probe-dist/ios.js.map --assets-dest probe-dist/ios-assets && expo export:embed --entry-file probe/core-probe.ts --platform android --dev false --minify false --bundle-output probe-dist/android.js --sourcemap-output probe-dist/android.js.map --assets-dest probe-dist/android-assets && node probe/check-probe.js probe-dist/ios.js probe-dist/android.js",
    "deps:check": "expo install --check",
    "gen:core": "node ../../scripts/native/gen-core-extract.mjs && node ../../scripts/native/core-closure.mjs --write",
    "gen:tokens": "node ../../scripts/native/gen-tokens.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.56.0",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.23",
    "expo-status-bar": "57.0.1",
    "lucide-react-native": "1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.3",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  },
  "overrides": {
    "@supabase/storage-js": "2.11.0"
  }
}
